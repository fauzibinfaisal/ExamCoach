{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "ready"
        },
        "serverNowMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "tryout": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "subtests": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "questionCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 43200
            },
            "submissionGraceSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          },
          "required": [
            "title",
            "subtests",
            "questionCount",
            "durationSeconds",
            "submissionGraceSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "serverNowMs",
        "createdAtMs",
        "expiresAtMs",
        "tryout"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "claimed"
        }
      },
      "required": ["schemaVersion", "status"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "expired"
        }
      },
      "required": ["schemaVersion", "status"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "revoked"
        }
      },
      "required": ["schemaVersion", "status"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "completed"
        }
      },
      "required": ["schemaVersion", "status"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "invalid"
        }
      },
      "required": ["schemaVersion", "status"],
      "additionalProperties": false
    }
  ],
  "$id": "urn:examcoach:web-cbt:link-status:v1"
}
