rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Mobile learning mutations go through authenticated callable functions so
    // ownership, idempotency, and state transitions are enforced server-side.
    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow write: if false;
    }

    match /users/{userId}/{document=**} {
      allow read: if signedInAs(userId);
      allow write: if false;
    }

    // Published content is server/CMS-managed. Draft and validated artifacts
    // are never exposed by this public path.
    match /published_question_packs/{packId} {
      allow read: if resource.data.validation_status == 'published';
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
