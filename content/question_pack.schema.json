{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examcoach.id/schemas/question-pack.json",
  "title": "ExamCoach Question Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pack", "questions"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "pack": { "$ref": "#/$defs/pack" },
    "questions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "maxLength": 128
    },
    "reviewer": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "promptVersion", "generatedAt"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "promptVersion": { "const": "ai_question_pack_v1" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "examId",
        "testId",
        "version",
        "validationStatus",
        "author",
        "reviewer",
        "generation",
        "tryoutQuestionIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "examId": { "$ref": "#/$defs/id" },
        "testId": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "validationStatus": {
          "enum": ["draft", "validated", "published"]
        },
        "author": { "$ref": "#/$defs/id" },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "generation": { "$ref": "#/$defs/generation" },
        "review": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/review" }]
        },
        "publication": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/publication" }
          ]
        },
        "tryoutQuestionIds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examId",
        "testId",
        "domainId",
        "topicId",
        "subtopicId",
        "skillId",
        "microSkillId",
        "topicLabel"
      ],
      "properties": {
        "examId": { "$ref": "#/$defs/id" },
        "testId": { "$ref": "#/$defs/id" },
        "domainId": { "$ref": "#/$defs/id" },
        "topicId": { "$ref": "#/$defs/id" },
        "subtopicId": { "$ref": "#/$defs/id" },
        "skillId": { "$ref": "#/$defs/id" },
        "microSkillId": { "$ref": "#/$defs/id" },
        "topicLabel": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "options",
        "correctOptionId",
        "taxonomy",
        "difficulty",
        "cognitiveType",
        "estimatedTimeSeconds",
        "trapType",
        "provenance",
        "author",
        "reviewer",
        "explanation",
        "validationStatus",
        "version"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prompt": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/option" }
        },
        "correctOptionId": { "$ref": "#/$defs/id" },
        "taxonomy": { "$ref": "#/$defs/taxonomy" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "cognitiveType": { "type": "string", "minLength": 1 },
        "estimatedTimeSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "trapType": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/$defs/id" },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "explanation": {
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        },
        "validationStatus": {
          "enum": ["draft", "validated", "published"]
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factualCorrectness",
        "singleDefensibleAnswer",
        "promptClarity",
        "distractorQuality",
        "explanationQuality",
        "taxonomyAccuracy",
        "difficultyCalibration",
        "languageQuality",
        "inclusivity",
        "provenanceRights",
        "similarityRisk"
      ],
      "properties": {
        "factualCorrectness": { "const": true },
        "singleDefensibleAnswer": { "const": true },
        "promptClarity": { "const": true },
        "distractorQuality": { "const": true },
        "explanationQuality": { "const": true },
        "taxonomyAccuracy": { "const": true },
        "difficultyCalibration": { "const": true },
        "languageQuality": { "const": true },
        "inclusivity": { "const": true },
        "provenanceRights": { "const": true },
        "similarityRisk": { "const": true }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentSha256",
        "reviewerId",
        "reviewedAt",
        "notes",
        "provenanceDecision",
        "provenanceNotes",
        "reviewedQuestionIds",
        "checks"
      ],
      "properties": {
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewerId": { "$ref": "#/$defs/id" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "minLength": 10 },
        "provenanceDecision": {
          "enum": ["original", "licensed", "publicDomain", "aiGeneratedOriginal"]
        },
        "provenanceNotes": { "type": "string", "minLength": 10 },
        "reviewedQuestionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "checks": { "$ref": "#/$defs/reviewChecks" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisherId", "publishedAt"],
      "properties": {
        "publisherId": { "$ref": "#/$defs/id" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "pack": {
            "properties": {
              "validationStatus": { "const": "draft" },
              "reviewer": { "type": "null" },
              "review": { "type": "null" },
              "publication": { "type": "null" }
            }
          },
          "questions": {
            "items": {
              "properties": {
                "validationStatus": { "const": "draft" },
                "reviewer": { "type": "null" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": {
        "properties": {
          "pack": {
            "required": ["review", "publication"],
            "properties": {
              "validationStatus": { "enum": ["validated", "published"] },
              "reviewer": { "$ref": "#/$defs/id" },
              "review": { "$ref": "#/$defs/review" }
            }
          },
          "questions": {
            "items": {
              "properties": {
                "validationStatus": { "enum": ["validated", "published"] },
                "reviewer": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pack": {
            "properties": { "validationStatus": { "const": "validated" } }
          }
        }
      },
      "then": {
        "properties": {
          "pack": {
            "properties": { "publication": { "type": "null" } }
          },
          "questions": {
            "items": {
              "properties": {
                "validationStatus": { "const": "validated" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pack": {
            "properties": { "validationStatus": { "const": "published" } }
          }
        }
      },
      "then": {
        "properties": {
          "pack": {
            "properties": {
              "publication": { "$ref": "#/$defs/publication" }
            }
          },
          "questions": {
            "items": {
              "properties": {
                "validationStatus": { "const": "published" }
              }
            }
          }
        }
      }
    }
  ]
}
